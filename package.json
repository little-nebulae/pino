{
  "name": "@little-nebulae/pino",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --fix --disable-nested-config",
    "check": "pnpm run lint && pnpm run fmt:check",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "test": "vitest run",
    "try": "oxnode ./src/try.ts"
  },
  "dependencies": {
    "pino": "10.4.0",
    "pino-abstract-transport": "3.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@little-nebulae/error": "1.4.0",
    "@little-nebulae/json": "0.5.1",
    "@little-nebulae/node-env": "0.4.0",
    "@little-nebulae/node-fs": "0.2.0",
    "@little-nebulae/result": "1.4.0",
    "@little-nebulae/superjson": "0.2.0",
    "@little-nebulae/zod": "0.5.0",
    "@oxc-node/cli": "0.1.6",
    "@types/node": "26.6.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "type-fest": "5.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@little-nebulae/error": "^1.0.0",
    "@little-nebulae/json": "0",
    "@little-nebulae/node-env": "0",
    "@little-nebulae/node-fs": "0",
    "@little-nebulae/result": "^1.0.0",
    "@little-nebulae/superjson": "0",
    "@little-nebulae/zod": "0",
    "type-fest": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
